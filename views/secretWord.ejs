<%- include("partials/head.ejs") %>
<%- include("partials/header.ejs") %>
<p>The secret word is: <%= secretWord %></p>
<p>Would you like to change it?</p>
<form method="POST">
    <input type="hidden" name="_csrf" value="<%= _csrf %>"> <!-- CSRF Token -->
    <label for="secretWord">Enter a new secret word:</label>
    <input type="text" id="secretWord" name="secretWord" />
    <button type="submit">Update</button>
</form>
<%- include("partials/footer.ejs") %>
