<%- include("partials/head.ejs") %>
<%- include("partials/header.ejs") %>

<h2>Expenses List</h2>

<!-- Add New Expense Button -->
<div style="margin-bottom: 20px;">
    <a href="/expenses/form">
        <button type="button">Add New Expense</button>
    </a>
</div>

<!-- Expense Table with Filters in Headers -->
<form method="GET" action="/expenses" style="display:inline;">
    <table id="expenses-table">
        <thead>
        <tr>
            <th>Category</th>
            <th>Description</th>
            <th>Amount</th>
            <th colspan="3"></th> <!-- For Show/Edit/Delete buttons -->
        </tr>
        <tr id="expenses-table-header">
            <!-- Category Filter in Header -->
            <th>
                <input type="text" name="category" placeholder="Filter by Category" value="<%= categoryFilter %>">
            </th>
            <!-- Description Filter in Header -->
            <th>
                <input type="text" name="description" placeholder="Filter by Description" value="<%= descriptionFilter %>">
            </th>
            <!-- Amount Filter in Header -->
            <th>
                <input type="number" name="amount" placeholder="Filter by Amount" value="<%= amountFilter %>">
            </th>
            <th colspan="3">
                <!-- Apply Filters Button -->
                <button type="submit" style="margin-top: 5px;">Apply Filters</button>
                <!-- Reset Filters Button -->
                <a href="/expenses" style="margin-top: 5px;">Reset Filters</a>
            </th>
        </tr>
        </thead>
        <tbody>
        <% if (expenses && expenses.length) { %>
            <% expenses.forEach((expense) => { %>
                <tr>
                    <td><%= expense.category %></td>
                    <td><%= expense.description %></td>
                    <td><%= expense.amount %></td>
                    <td>
                        <!-- Show Expense Button -->
                        <a href="/expenses/<%= expense.id %>">
                            <button type="button">Show Expense</button>
                        </a>
                    </td>
                    <td>
                        <!-- Edit Button -->
                        <a href="/expenses/form/<%= expense.id %>">
                            <button type="button">Edit Expense</button>
                        </a>
                    </td>
                    <td>
                        <!-- Delete Button -->
                        <form method="POST" action="/expenses/delete/<%= expense.id %>?page=<%= currentPage %>&limit=<%= limit %>&category=<%= categoryFilter %>&description=<%= descriptionFilter %>&amount=<%= amountFilter %>" style="display:inline;">
                            <input type="hidden" name="_csrf" value="<%= _csrf %>"> <!-- CSRF Token -->
                            <button type="submit">Delete Expense</button>
                        </form>
                    </td>
                </tr>
            <% }) %>
        <% } else { %>
            <tr>
                <td colspan="6" class="text-center">No expenses found. Click the "Add New Expense" button above to create one!</td>
            </tr>
        <% } %>
        </tbody>
    </table>
</form>

<!-- Pagination Controls -->
<div class="pagination">
    <% if (hasPrevPage) { %>
        <a href="/expenses?page=<%= currentPage - 1 %>&limit=<%= limit %>&category=<%= categoryFilter %>&description=<%= descriptionFilter %>&amount=<%= amountFilter %>">Previous</a>
    <% } else { %>
        <button disabled>Previous</button>
    <% } %>

    <span>Page <%= currentPage %> of <%= totalPages %></span>

    <% if (hasNextPage) { %>
        <a href="/expenses?page=<%= currentPage + 1 %>&limit=<%= limit %>&category=<%= categoryFilter %>&description=<%= descriptionFilter %>&amount=<%= amountFilter %>">Next</a>
    <% } else { %>
        <button disabled>Next</button>
    <% } %>
</div>

<!-- Script to add confirmation before deleting an expense -->
<script>
    // Add confirmation before deleting an expense
    document.querySelectorAll('.delete-button').forEach(button => {
        button.addEventListener('click', function(event) {
            const confirmation = confirm("Are you sure you want to delete this expense?");
            if (!confirmation) {
                event.preventDefault(); // Prevent form submission if canceled
            }
        });
    });
</script>

<%- include("partials/footer.ejs") %>
